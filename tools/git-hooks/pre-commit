#!/usr/bin/env bash
# Vor jedem Commit: Fassung hochzählen (nur neue Kennung, wenn version.json schon vorgemerkt ist), vormerken und die
# vorgemerkten Dateien prüfen (nur gerade Zeichen). Die Prüfungen stehen an einer Stelle im Appkern (appkern.werkzeuge).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
exec .venv/bin/python -m appkern.werkzeuge vor-dem-commit
